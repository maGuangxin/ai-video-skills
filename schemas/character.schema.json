{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schemas/character.schema.json",
  "title": "Character 10-item Anchor (cross-project minimum required fields)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "semanticNameEnglish",
    "race",
    "gender",
    "ageEstimate",
    "heightBodyType",
    "professionOrRole",
    "hairStyleColor",
    "eyeColorOrFeature",
    "iconicEquipment10Items",
    "corePersonality",
    "relationshipToOtherChars"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^char-[a-z0-9-]+$",
      "examples": ["char-taivy-gnome", "char-marcus-paladin"]
    },
    "semanticNameEnglish": { "type": "string" },
    "race": { "type": "string" },
    "gender": { "type": "string", "enum": ["male", "female", "other", "tbd"] },
    "ageEstimate": {
      "type": "object",
      "required": ["visualAppearanceAgeMin", "visualAppearanceAgeMax"],
      "properties": {
        "visualAppearanceAgeMin": { "type": "integer", "minimum": 3 },
        "visualAppearanceAgeMax": { "type": "integer", "minimum": 3 }
      }
    },
    "heightBodyType": {
      "type": "object",
      "required": ["heightCmOrRelativeRatio", "bodyBuild"],
      "properties": {
        "heightCmOrRelativeRatio": {
          "type": "string",
          "description": "写实风格建议真实厘米数或头身比；侏儒例'90cm / 头身1:3.2~1:3.5，禁止大头娃娃'"
        },
        "bodyBuild": { "type": "string", "examples": ["slim", "athletic", "muscular", "plus-size"] }
      }
    },
    "professionOrRole": { "type": "string" },
    "hairStyleColor": {
      "type": "object",
      "required": ["style", "colorExact", "bannedWords"],
      "properties": {
        "style": { "type": "string" },
        "colorExact": {
          "type": "string",
          "description": "精确颜色描述，写实风格禁止渐变/挑染描述，除非用户明确确认"
        },
        "bannedWords": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "eyeColorOrFeature": { "type": "string" },
    "iconicEquipment10Items": {
      "type": "array",
      "minItems": 5,
      "maxItems": 15,
      "items": {
        "type": "object",
        "required": ["slot", "description", "materialTexture"],
        "properties": {
          "slot": {
            "type": "string",
            "enum": ["head", "neck", "shoulder", "chest", "back", "hands", "waist", "legs", "feet", "weapon-main", "accessory", "gem-or-core"]
          },
          "description": { "type": "string" },
          "materialTexture": { "type": "string" }
        }
      },
      "description": "角色不可变装备 9~12 项（用于完整前缀强制复制法，写实风格必须列全列细）"
    },
    "corePersonality": { "type": "string" },
    "relationshipToOtherChars": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["targetCharId", "relationshipType"],
        "properties": {
          "targetCharId": { "type": "string" },
          "relationshipType": {
            "type": "string",
            "examples": ["lovers-romantic", "master-apprentice", "partners-combat", "siblings", "enemies"]
          }
        }
      }
    }
  }
}
