{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "schemas/prompt.schema.json",
    "title": "Video Prompt Per Shot (with style-activated 3 core techniques)",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "schemaVersion",
        "shotId",
        "aspectRatio",
        "durationSeconds",
        "firstRealismPinch",
        "charactersSectionFullPrefixPaste",
        "secondRealismPinchAfterChars",
        "sceneSection",
        "cameraCinematicBlock",
        "actionTimestampsLipSync",
        "lightingMagicBlock",
        "thirdRealismPinchAfterLighting",
        "negativePromptBuckets6",
        "fallbackPlan3",
        "chineseVersion",
        "englishVersion"
    ],
    "properties": {
        "schemaVersion": {
            "type": "string",
            "const": "1.0.0"
        },
        "shotId": {
            "type": "string"
        },
        "aspectRatio": {
            "type": "string"
        },
        "durationSeconds": {
            "type": "integer"
        },
        "firstRealismPinch": {
            "type": "object",
            "description": "写实3次夹攻法第1次：开头双写实前缀（权重最高位），其他风格替换为该风格的专属前缀模板",
            "required": [
                "activated",
                "textZh",
                "textEn"
            ],
            "properties": {
                "activated": {
                    "type": "boolean"
                },
                "textZh": {
                    "type": "string"
                },
                "textEn": {
                    "type": "string"
                }
            }
        },
        "charactersSectionFullPrefixPaste": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "object",
                "required": [
                    "charId",
                    "fullPrefixThreeLinesVerbatimPaste",
                    "percentagePrivilegeAnchors",
                    "furnitureAnchorCmIfApplicable"
                ],
                "properties": {
                    "charId": {
                        "type": "string"
                    },
                    "fullPrefixThreeLinesVerbatimPaste": {
                        "type": "array",
                        "minItems": 3,
                        "maxItems": 3,
                        "items": {
                            "type": "string"
                        },
                        "description": "完整前缀强制复制法：从角色一致性约束 3.1/3.2/3.3 直接复制原3行，不允许 AI 简写或漏掉任何铠甲/长袍/宝石细节"
                    },
                    "percentagePrivilegeAnchors": {
                        "type": "object",
                        "description": "百分比特权锚点法：写实风格强制写入头顶%/鞋底%，收窄 AI 构图自由度防比例翻车"
                    },
                    "furnitureAnchorCmIfApplicable": {
                        "type": [
                            "string",
                            "null"
                        ]
                    }
                }
            }
        },
        "secondRealismPinchAfterChars": {
            "type": "object",
            "description": "写实3次夹攻法第2次：角色段末尾二次材质写实（布料/金属/宝石真实物理属性）",
            "required": [
                "activated",
                "materialTextZh",
                "materialTextEn"
            ],
            "properties": {
                "activated": {
                    "type": "boolean"
                },
                "materialTextZh": {
                    "type": "string"
                },
                "materialTextEn": {
                    "type": "string"
                }
            }
        },
        "sceneSection": {
            "type": "string"
        },
        "cameraCinematicBlock": {
            "type": "object",
            "required": [
                "shotScaleProfessional",
                "compositionProfessional",
                "lensProfessional",
                "frameRateProfessional",
                "colorGradingProfessional"
            ],
            "properties": {
                "shotScaleProfessional": {
                    "type": "string"
                },
                "compositionProfessional": {
                    "type": "string"
                },
                "lensProfessional": {
                    "type": "string"
                },
                "frameRateProfessional": {
                    "type": "string"
                },
                "colorGradingProfessional": {
                    "type": "string"
                }
            },
            "description": "全部来自 cinematic-knowledge.yaml 专业映射，用户不说术语，Agent 内部自动填专业值"
        },
        "actionTimestampsLipSync": {
            "type": "object",
            "required": [
                "activated",
                "positiveKeywords6",
                "negativeKeywords7"
            ],
            "properties": {
                "activated": {
                    "type": "boolean"
                },
                "positiveKeywords6": {
                    "type": "array",
                    "minItems": 6,
                    "maxItems": 6,
                    "items": {
                        "type": "string"
                    }
                },
                "negativeKeywords7": {
                    "type": "array",
                    "minItems": 7,
                    "maxItems": 7,
                    "items": {
                        "type": "string"
                    }
                }
            }
        },
        "lightingMagicBlock": {
            "type": "string"
        },
        "thirdRealismPinchAfterLighting": {
            "type": "object",
            "description": "写实3次夹攻法第3次：灯光/魔法特效段末尾三次写实（禁平光/禁卡通渲染）",
            "required": [
                "activated",
                "antiFlatLightZh",
                "antiFlatLightEn"
            ],
            "properties": {
                "activated": {
                    "type": "boolean"
                },
                "antiFlatLightZh": {
                    "type": "string"
                },
                "antiFlatLightEn": {
                    "type": "string"
                }
            }
        },
        "negativePromptBuckets6": {
            "type": "object",
            "description": "6大类负向词桶：口型7+卡通风13+材质9+比例9+细节10+基础10，写实风格全部激活；其他风格按需删减卡通桶",
            "required": [
                "lipSync7",
                "cartoonStyling13",
                "materialsTexture9",
                "proportionPerspective9",
                "characterDetails10",
                "basicCommon10"
            ],
            "properties": {
                "lipSync7": {
                    "type": "array",
                    "minItems": 7,
                    "maxItems": 7
                },
                "cartoonStyling13": {
                    "type": "array",
                    "minItems": 13,
                    "maxItems": 13
                },
                "materialsTexture9": {
                    "type": "array",
                    "minItems": 9,
                    "maxItems": 9
                },
                "proportionPerspective9": {
                    "type": "array",
                    "minItems": 9,
                    "maxItems": 9
                },
                "characterDetails10": {
                    "type": "array",
                    "minItems": 10,
                    "maxItems": 10
                },
                "basicCommon10": {
                    "type": "array",
                    "minItems": 10,
                    "maxItems": 10
                }
            }
        },
        "fallbackPlan3": {
            "type": "object",
            "description": "翻车兜底3条：豆包端局部修改功能（圈选区域+时间段+指令文本），只改嘴型/卡通风/发色宝石色，不整段重抽（15%积分）",
            "required": [
                "lipSyncFix",
                "cartoonStyleFix",
                "hairGemColorFix"
            ],
            "properties": {
                "lipSyncFix": {
                    "type": "string"
                },
                "cartoonStyleFix": {
                    "type": "string"
                },
                "hairGemColorFix": {
                    "type": "string"
                }
            }
        },
        "chineseVersion": {
            "type": "string"
        },
        "englishVersion": {
            "type": "string"
        }
    }
}